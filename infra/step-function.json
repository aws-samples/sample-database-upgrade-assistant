{
  "Comment": "Aurora Upgrade Test Pipeline — Baseline → Clone → WaitForClone → Upgrade → WaitForUpgrade → Validation → Cleanup",
  "StartAt": "Baseline",
  "States": {
    "Baseline": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:REGION:ACCOUNT:function:aurora-upgrade-planner-baseline",
      "ResultPath": "$.stepResult",
      "TimeoutSeconds": 900,
      "Next": "Clone",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "BaselineFailed"
        }
      ]
    },
    "BaselineFailed": {
      "Type": "Pass",
      "Comment": "Baseline failed before clone was created — no cleanup needed",
      "End": true
    },
    "Clone": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:REGION:ACCOUNT:function:aurora-upgrade-planner-clone",
      "InputPath": "$.stepResult",
      "ResultPath": "$.stepResult",
      "TimeoutSeconds": 900,
      "Next": "InitClonePollCount",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "CloneCreateFailed"
        }
      ]
    },
    "CloneCreateFailed": {
      "Type": "Pass",
      "Comment": "Clone creation threw an error. Pass runId so Cleanup can look up cloneId from DynamoDB.",
      "Parameters": {
        "runId.$": "$.stepResult.runId",
        "cloneId": ""
      },
      "ResultPath": "$.stepResult",
      "Next": "Cleanup"
    },
    "InitClonePollCount": {
      "Type": "Pass",
      "Result": {"count": 0},
      "ResultPath": "$.pollCount",
      "Next": "WaitForClone"
    },
    "WaitForClone": {
      "Type": "Wait",
      "Seconds": 60,
      "Next": "PollCloneStatus"
    },
    "PollCloneStatus": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:REGION:ACCOUNT:function:aurora-upgrade-planner-poll-status",
      "InputPath": "$.stepResult",
      "ResultPath": "$.pollResult",
      "TimeoutSeconds": 900,
      "Next": "IncrementClonePollCount",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "Cleanup"
        }
      ]
    },
    "IncrementClonePollCount": {
      "Type": "Pass",
      "Parameters": {
        "count.$": "States.MathAdd($.pollCount.count, 1)"
      },
      "ResultPath": "$.pollCount",
      "Next": "CheckCloneStatus"
    },
    "CheckCloneStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.pollResult.status",
          "StringEquals": "available",
          "Next": "Upgrade"
        },
        {
          "Variable": "$.pollResult.status",
          "StringEquals": "failed",
          "Next": "CloneFailed"
        },
        {
          "Variable": "$.pollResult.status",
          "StringEquals": "deleting",
          "Next": "CloneFailed"
        },
        {
          "Variable": "$.pollCount.count",
          "NumericGreaterThanEquals": 60,
          "Next": "CloneTimeout"
        }
      ],
      "Default": "WaitForClone"
    },
    "CloneFailed": {
      "Type": "Pass",
      "Result": {"error": "CloneFailed", "cause": "Clone cluster entered failed or deleting state"},
      "ResultPath": "$.failureInfo",
      "Next": "Cleanup"
    },
    "CloneTimeout": {
      "Type": "Pass",
      "Result": {"error": "CloneTimeout", "cause": "Clone did not become available within 60 minutes"},
      "ResultPath": "$.failureInfo",
      "Next": "Cleanup"
    },
    "Upgrade": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:REGION:ACCOUNT:function:aurora-upgrade-planner-upgrade",
      "Parameters": {
        "runId.$": "$.stepResult.runId",
        "cloneId.$": "$.stepResult.cloneId"
      },
      "ResultPath": "$.stepResult",
      "TimeoutSeconds": 900,
      "Next": "InitUpgradePollCount",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "Cleanup"
        }
      ]
    },
    "InitUpgradePollCount": {
      "Type": "Pass",
      "Result": {"count": 0},
      "ResultPath": "$.pollCount",
      "Next": "WaitForUpgrade"
    },
    "WaitForUpgrade": {
      "Type": "Wait",
      "Seconds": 60,
      "Next": "PollUpgradeStatus"
    },
    "PollUpgradeStatus": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:REGION:ACCOUNT:function:aurora-upgrade-planner-poll-status",
      "InputPath": "$.stepResult",
      "ResultPath": "$.pollResult",
      "TimeoutSeconds": 900,
      "Next": "IncrementUpgradePollCount",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "Cleanup"
        }
      ]
    },
    "IncrementUpgradePollCount": {
      "Type": "Pass",
      "Parameters": {
        "count.$": "States.MathAdd($.pollCount.count, 1)"
      },
      "ResultPath": "$.pollCount",
      "Next": "CheckUpgradeStatus"
    },
    "CheckUpgradeStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.pollResult.status",
          "StringEquals": "available",
          "Next": "Validation"
        },
        {
          "Variable": "$.pollResult.status",
          "StringEquals": "failed",
          "Next": "UpgradeFailed"
        },
        {
          "Variable": "$.pollResult.status",
          "StringEquals": "deleting",
          "Next": "UpgradeFailed"
        },
        {
          "Variable": "$.pollCount.count",
          "NumericGreaterThanEquals": 60,
          "Next": "UpgradeTimeout"
        }
      ],
      "Default": "WaitForUpgrade"
    },
    "UpgradeFailed": {
      "Type": "Pass",
      "Result": {"error": "UpgradeFailed", "cause": "Upgrade cluster entered failed or deleting state"},
      "ResultPath": "$.failureInfo",
      "Next": "Cleanup"
    },
    "UpgradeTimeout": {
      "Type": "Pass",
      "Result": {"error": "UpgradeTimeout", "cause": "Upgrade did not complete within 60 minutes"},
      "ResultPath": "$.failureInfo",
      "Next": "Cleanup"
    },
    "Validation": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:REGION:ACCOUNT:function:aurora-upgrade-planner-validation",
      "Parameters": {
        "runId.$": "$.stepResult.runId",
        "cloneId.$": "$.stepResult.cloneId"
      },
      "ResultPath": "$.stepResult",
      "TimeoutSeconds": 900,
      "Next": "Cleanup",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "Cleanup"
        }
      ]
    },
    "Cleanup": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:REGION:ACCOUNT:function:aurora-upgrade-planner-cleanup",
      "Parameters": {
        "runId.$": "$.stepResult.runId",
        "cloneId.$": "$.stepResult.cloneId"
      },
      "TimeoutSeconds": 900,
      "End": true,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "CleanupFailed"
        }
      ]
    },
    "CleanupFailed": {
      "Type": "Fail",
      "Error": "CleanupFailed",
      "Cause": "Cleanup Lambda failed — manual clone deletion may be required"
    }
  }
}
