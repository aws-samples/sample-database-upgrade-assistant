{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "auroraupgradeplanner",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "auroraupgradeplanner"
  },
  "runtimes": [
    {
      "name": "catalog_extract",
      "build": "CodeZip",
      "entrypoint": "main.py",
