      "codeLocation": "app/code_enrichment/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    },
    {
      "name": "report",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/report/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    }
  ],
  "memories": [],
